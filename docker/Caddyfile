# Caddy config untuk FrankenPHP serving Laravel
# SERVER_NAME diset via env (Render: ":${PORT}", lokal: ":8080")
{
	frankenphp
	order php_server before file_server
	auto_https off

	# Disable admin API — tidak dibutuhkan di production,
	# dan menghindari error "Operation not permitted" saat bind admin socket.
	admin off
}

{$SERVER_NAME:":8080"} {
	root * /app/public
	encode zstd br gzip

	# Cache aset hashed Vite
	@assets {
		path /build/*
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	php_server
	file_server

	log {
		output stderr
		format console
	}
}
