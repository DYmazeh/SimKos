APP_NAME=SIMKOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === DATABASE ===
# Lokal (dev): default sqlite
DB_CONNECTION=sqlite

# Production (Supabase Postgres) — hapus DB_CONNECTION sqlite di atas, ganti dengan ini:
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543                           # 6543 = transaction pooler (untuk runtime)
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<your-supabase-db-password>
# DB_SSLMODE=require
# DB_SCHEMA=public
#
# Migration / artisan command (tidak boleh pakai pooler 6543):
# DB_DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# === SUPABASE STORAGE (untuk foto KTP & bukti transfer) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=simkos-uploads

# === MAIL (opsional) ===
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@simkos.test"
MAIL_FROM_NAME="${APP_NAME}"
# Brevo HTTP API (port 443) — workaround Render free tier yang block SMTP.
# Set MAIL_MAILER=brevo + BREVO_API_KEY=<key> dari Brevo dashboard (Settings → API Keys).
BREVO_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# === SIMKOS-specific ===
SIMKOS_REMINDER_DAYS=3
SIMKOS_JATUH_TEMPO_TANGGAL=5
# Token untuk webhook /cron/run — set di Render dashboard, pasangkan dgn ping
# dari UptimeRobot/cron-job.org. Tanpa token (kosong) endpoint abort 403.
SIMKOS_CRON_TOKEN=
SIMKOS_KOS_NAMA="Kos Sejahtera"
SIMKOS_KOS_ALAMAT="Jl. Contoh No. 123, Bandar Lampung"
SIMKOS_KONTAK_HP="081234567890"
SIMKOS_REKENING_BANK="BCA"
SIMKOS_REKENING_NOMOR="1234567890"
SIMKOS_REKENING_NAMA="Nama Pemilik Kos"

# === SENTRY (error tracking — opsional, free tier sentry.io 5k events/mo) ===
# Bikin project di sentry.io, copy DSN ke sini. Kosongkan untuk disable.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
